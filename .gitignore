# Go toolchain telemetry dropped at the repo root when a container runs go
# with the checkout as its working directory. Never source code.
.config/
.cache/
/bin/
/dist/
*.exe
*.wasm

# ...except the built first-party guests, which are checked in so `go test ./...`
# works without a wasm toolchain. CI rebuilds them from source in the `guests`
# job and runs the same tests against the fresh bytes, which is what keeps the
# committed artifact honest.
!internal/wasmhost/testdata/*.wasm

# local dev state
.env
.env.local
/tmp/
/testdata/local/

# Cargo's build output for the Rust tree.
/target/

# gate-container.sh's build and module caches, mounted into the container from
# here so they survive between runs. Never source code.
.gocache/

# Build outputs of scripts/build-desktop.sh.
/desktop/bin/
/desktop/dist/

# node, for the Playwright-driven integration tests only
node_modules/
test/e2e/test-results/
test/e2e/playwright-report/
test/e2e/.playwright/

# Harness image pins. A locally built image has a machine-local digest, so this
# is build output rather than a committed pin; the committed pin is the version
# ARGs in docker/harness/Containerfile. Revisit when harness images get a
# registry (harnesses.md open question 2).
docker/harness/digests.json
docker/egress/digest.json

# Generated per machine by scripts/garage-up, never committed. The dev Garage
# binds to loopback and holds test objects, but a checked-in RPC secret in a
# public repo is a thing someone eventually copies into a deployment.
docker/garage/garage.env
