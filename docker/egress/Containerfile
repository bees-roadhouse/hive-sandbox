# The allowlisting egress proxy a harness run reaches the internet through
# (D12.6, D23).
#
# It is the same hive-sandbox binary running its --run-egress-proxy role, so
# there is one codebase and one place the allowlist logic lives. The proxy sits
# on a per-run internal Podman network: the harness has no route out except
# through it, and it answers one question per request.
#
# Built by scripts/egress-build.sh from the repo root, because the build stage
# needs the whole workspace.

FROM docker.io/library/rust:1.98-bookworm AS build

WORKDIR /src
COPY . .

ARG VERSION=dev
ENV HIVE_SANDBOX_VERSION=${VERSION}
RUN cargo build --release -p hive-sandbox \
    && cp target/release/hive-sandbox /out-hive-sandbox

# --- runtime -----------------------------------------------------------------
# Distroless cc: no shell, no package manager, nothing to pivot to if the proxy
# is ever compromised. It tunnels TLS rather than terminating it, and the
# plain-HTTP forward path's own dials need no certificate store.
FROM gcr.io/distroless/cc-debian12:nonroot AS proxy

COPY --from=build /out-hive-sandbox /usr/local/bin/hive-sandbox

# nonroot in the distroless base.
USER 65532:65532

EXPOSE 3128

LABEL org.beesroadhouse.hive-sandbox.component=egress-proxy

# Only the proxy role. An egress proxy that also served the API would be a way
# around the isolation it exists to enforce.
#
# The allowlist arrives at run time as HIVE_SANDBOX_EGRESS_ALLOW. There is no
# default, and no allowlist means deny everything.
ENTRYPOINT ["/usr/local/bin/hive-sandbox", \
            "--serve-api=false", \
            "--run-workflows=false", \
            "--run-chat=false", \
            "--run-egress-proxy", \
            "--egress-addr=:3128"]
