# Toolchain state dropped at the repo root when a container runs with the
# checkout as its working directory. Never source code.
.config/
.cache/
/bin/
/dist/
*.exe
*.wasm

# ...except the built first-party guests, which are checked in so `cargo test`
# works without the wasm target installed. CI rebuilds them from source in the
# `guests` job and runs the same tests against the fresh bytes, which is what
# keeps the committed artifact honest.
!crates/hive-wasmhost/testdata/*.wasm

# local dev state
.env
.env.local
/tmp/
/testdata/local/

# Cargo's build output for the Rust tree, and for the guest workspaces.
/target/
/guest/target/
/apps/*/target/

# The browser client's build is committed (web/dist, embedded by
# crates/hive-webui); its dependencies are not.
/web/node_modules/

# gate-container.sh's cargo caches, mounted into the container from here so
# they survive between runs. Never source code.
.cargo-cache/

# node, for the Playwright-driven integration tests only
node_modules/
test/e2e/test-results/
test/e2e/playwright-report/
test/e2e/.playwright/

# Harness image pins. A locally built image has a machine-local digest, so this
# is build output rather than a committed pin; the committed pin is the version
# ARGs in docker/harness/Containerfile. Revisit when harness images get a
# registry (harnesses.md open question 2).
docker/harness/digests.json
docker/egress/digest.json

# Generated per machine by scripts/garage-up, never committed. The dev Garage
# binds to loopback and holds test objects, but a checked-in RPC secret in a
# public repo is a thing someone eventually copies into a deployment.
docker/garage/garage.env
