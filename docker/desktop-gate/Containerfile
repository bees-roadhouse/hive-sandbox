# The desktop gate: the host gate's toolchain plus what a Wails Linux build
# needs to link.
#
# Wails v3 defaults to GTK4/WebKitGTK 6.0, which Debian 12 (bookworm) does not
# ship; this repo builds the desktop with `-tags gtk3` (WebKit2GTK 4.1), which
# bookworm and every CI runner image do ship and which v3 supports through
# 3.0.x. Built by scripts/build-desktop.sh --image on first use, from the repo
# root.
FROM docker.io/library/golang:1.26-bookworm

# Built from source with THIS image's Go, for the same reason docker/gate
# states: a golangci-lint compiled against an older Go refuses to load a
# config targeting a newer one.
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

# CGO stays enabled here ... the webview is the point. The GTK and WebKit2GTK
# development packages are what `go build -tags gtk3 ./cmd/hive-desktop`
# links against; pkg-config is how wails finds them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git gcc pkg-config \
        libgtk-3-dev libwebkit2gtk-4.1-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pkg-config --exists webkit2gtk-4.1 && echo "webkit2gtk-4.1 present"

ENV GOFLAGS=-buildvcs=false

WORKDIR /src
